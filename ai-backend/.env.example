# ==============================================================================
# NUNNARRI IoT GATEWAY - AI BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

PORT=5006

# AI Provider Selection:
# 'auto'   - Uses Gemini API if GEMINI_API_KEY is set, otherwise falls back to local Ollama & smart rules
# 'gemini' - Uses Google Gemini API directly
# 'ollama' - Uses local Ollama instance directly
AI_PROVIDER=auto

# Google Gemini API Key (Get a free API key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Ollama Local AI Server Host (Optional fallback)
# Local host development: http://localhost:11434
# Docker Container: http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Database Connection
IOT_DATABASE_URL=postgres://postgres:postgres_password@localhost:5432/nexus_iot_db

# Security
JWT_SECRET=your_super_secret_jwt_key_change_in_production
