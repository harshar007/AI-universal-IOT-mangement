# ==============================================================================
# NUNNARRI IoT GATEWAY - AI BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

PORT=5006

# Ollama Local AI Server Host
# Local host development: http://localhost:11434
# Docker Container: http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434

# Recommended Ollama Models for IoT & AI Automation:
# 1. llama3.2    - (RECOMMENDED) Meta's 3B/1B model with exceptional reasoning & JSON output
# 2. qwen2.5     - Outstanding structured JSON control & IoT hardware command execution
# 3. mistral     - 7B model with strong general intelligence & instruction following
# 4. phi3        - Microsoft's fast & lightweight 3.8B mini model
# 5. tinyllama   - Ultra lightweight 1.1B model for resource-constrained hardware
OLLAMA_MODEL=llama3.2

# Database Connection
IOT_DATABASE_URL=postgres://postgres:postgres_password@localhost:5432/nexus_iot_db

# Security
JWT_SECRET=your_super_secret_jwt_key_change_in_production
