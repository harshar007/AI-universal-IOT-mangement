


# Server Network Configuration
PORT=5000

# Dual PostgreSQL Database Connection Strings
# Local setup example:
# USER_DATABASE_URL=postgres://postgres:your_password@localhost:5432/user_db
# IOT_DATABASE_URL=postgres://postgres:your_password@localhost:5433/nexus_iot_db
# Docker compose internal network example:
# USER_DATABASE_URL=postgres://postgres:prabha0312@user-db:5432/user_db
# IOT_DATABASE_URL=postgres://postgres:prabha0312@iot-db:5432/nexus_iot_db
USER_DATABASE_URL=postgres://postgres:postgres_password@localhost:5432/user_db
IOT_DATABASE_URL=postgres://postgres:postgres_password@localhost:5432/nexus_iot_db
DATABASE_URL=postgres://postgres:postgres_password@localhost:5432/nexus_iot_db

# Security & Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Microservice & Gateway Endpoints
GATEWAY_URL=http://localhost:5002

# GitHub OAuth Integration (OAuth Developer Settings on GitHub)
# Create your OAuth App at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost/api/auth/github/callback
FRONTEND_URL=http://localhost
